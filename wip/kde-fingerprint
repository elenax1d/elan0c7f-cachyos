#%PAM-1.0
# Override of /usr/lib/pam.d/kde-fingerprint (the lock screen's fingerprint check).
# - timeout=86400: keep listening for up to a day instead of 30 seconds
# - repeated lines: if a check times out, breaks after suspend, or uses up its
#   3 tries, the next line starts a fresh one (8 lines = up to 24 attempts)
# Password unlock uses a separate file (/usr/lib/pam.d/kde) and is unaffected.
# To undo: sudo rm /etc/pam.d/kde-fingerprint

auth       required                    pam_shells.so
auth       requisite                   pam_nologin.so
auth       requisite                   pam_faillock.so      preauth
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       [success=done default=ignore] pam_fprintd.so     timeout=86400
auth       required                    pam_deny.so

account    include                     system-local-login

password   required                    pam_deny.so

session    include                     system-local-login
